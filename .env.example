# 示例配置。在 RunPod 上不要用这个文件 —— 用 Pod 的 Environment Variables 注入。
# 这里只是列出所有可用变量，方便本地调试时 source。

# ── 凭证（必需）──
# GitHub Fine-grained PAT：只授权本仓库，权限只要 Contents: Read and write
GITHUB_TOKEN=github_pat_REPLACE_WITH_YOUR_TOKEN

# ── 飞书通知（可选）──
# 群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_WITH_YOUR_HOOK
# 机器人开了「签名校验」时必填，否则飞书返回 19021
FEISHU_SECRET=REPLACE_WITH_YOUR_SIGNING_SECRET

# ── 目标（都有默认值，无需设置）──
# 默认 "mathlib,oai"；只跑一个就写一个
# LCM_TARGETS=mathlib,oai
# LCM_OAI_SUBTREE=OAI/Analysis/Crouzeix
# LCM_OAI_FULL=1          # 编译整个 OAI，需 ~110G

# ── 运行参数（都有默认值）──
# LCM_WORK=/work          # 工作目录，默认容器盘
# JOBS=8                  # 默认按 vCPU 与内存自动定
# LCM_DEADLINE_HOURS=24   # 看门狗，0 关闭
# LCM_SELFTERM=0          # 关闭自动关机
# LCM_PUSH_REFS=1         # 连 refs.tsv 一起推
# LCM_RESULT_BRANCH=...   # 默认 results-<主机名>-<时间戳>
